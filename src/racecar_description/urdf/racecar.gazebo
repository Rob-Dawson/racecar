<?xml version="1.0"?>
<robot name="racecar" xmlns:xacro="http://www.ros.org/wiki/xacro">

      <xacro:macro name="imu_linear_noise">
        <mean>${imu_linear_mean}</mean>
        <stddev>${imu_linear_stddev}</stddev>
        <bias_mean>${imu_linear_bias_mean}</bias_mean>
        <bias_stddev>${imu_linear_bias_stddev}</bias_stddev>
        <dynamic_bias_stddev>${imu_linear_dynamic_bias_stddev}</dynamic_bias_stddev>
        <dynamic_bias_correlation_time>${imu_linear_dynamic_bias_correlation_time}</dynamic_bias_correlation_time>
    </xacro:macro>

    <xacro:macro name="imu_angular_noise">
        <mean>${imu_angular_mean}</mean>
        <stddev>${imu_angular_stddev}</stddev>
        <bias_mean>${imu_angular_bias_mean}</bias_mean>
        <bias_stddev>${imu_angular_bias_stddev}</bias_stddev>
        <dynamic_bias_stddev>${imu_angular_dynamic_bias_stddev}</dynamic_bias_stddev>
        <dynamic_bias_correlation_time>${imu_angular_dynamic_bias_correlation_time}</dynamic_bias_correlation_time>
    </xacro:macro>

  <xacro:property name="imu_angular_mean" value="0.0" />
    <xacro:property name="imu_angular_stddev" value="0.00262" />
    <xacro:property name="imu_angular_bias_mean" value="0.00" />
    <xacro:property name="imu_angular_bias_stddev" value="0.0087" />
    <xacro:property name="imu_angular_dynamic_bias_stddev" value="1.0e-6" />
    <xacro:property name="imu_angular_dynamic_bias_correlation_time" value="600" />

    <xacro:property name="imu_linear_mean" value="0.0" />
    <xacro:property name="imu_linear_stddev" value="0.0226" />
    <xacro:property name="imu_linear_bias_mean" value="0.00" />
    <xacro:property name="imu_linear_bias_stddev" value="0.147" />
    <xacro:property name="imu_linear_dynamic_bias_stddev" value="2.0e-3" />
    <xacro:property name="imu_linear_dynamic_bias_correlation_time" value="600" />



  <!-- Contact properties for the initial low-speed simulation.
       These are starting values, not calibrated tire parameters. -->




  <gazebo reference="chassis">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_rear_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_rear_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="left_front_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_front_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="imu_link">
        <sensor name="imu" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <gz_frame_id>imu_link</gz_frame_id>
            <topic>imu</topic>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <xacro:imu_angular_noise/>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <xacro:imu_angular_noise/>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <xacro:imu_angular_noise/>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <xacro:imu_linear_noise/>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <xacro:imu_linear_noise/>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <xacro:imu_linear_noise/>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
            <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
        </sensor>
    </gazebo>

  <!-- ROS 2 Jazzy / Gazebo Harmonic controller manager. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find racecar_control)/config/racecar_control.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Hokuyo-style planar LiDAR. Disable via DISABLE_GAZEBO_LASER=true. -->
  <xacro:unless value="$(optenv DISABLE_GAZEBO_LASER false)">
    <gazebo reference="laser">
      <sensor name="hokuyo_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>40</update_rate>
        <topic>scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-2.3561944902</min_angle>
              <max_angle>2.3561944902</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:unless>

  <!-- Left RGB camera only; this is not a stereo/depth simulation. -->
  <xacro:unless value="$(optenv DISABLE_GAZEBO_CAMERA false)">
    <gazebo reference="camera_link">
      <sensor name="zed_camera_left_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>camera/zed/image</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>0.8709216071359963</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:unless>

</robot>
